    print(f"  Zeile 5 Summe (Spiegel): {row_sums[4]} (224) -> Delta: +49")
    
    # Spiegel-Attraktor für die komplementäre Phase (857)
    # 1/7 = 0.142857 -> Komplement ist 1000 - 143 = 857
    dual_attractor = 857
    # Rückwärts-Projektion des Duals:
    dual_base = 224 - (dual_attractor % 49)
    print(f"\n6. MIDY-DUALITÄT (142 <-> 857):")
