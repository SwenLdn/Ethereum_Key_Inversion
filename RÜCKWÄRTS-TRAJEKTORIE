    print(f"  Komplementär-Attraktor: {dual_attractor} (Schwanz: 142 + 857 = 999)")
    print(f"  Paritäts-Kopplung: {attractor % 2} (gerade Phase) <-> {dual_attractor % 2} (ungerade Phase)")
