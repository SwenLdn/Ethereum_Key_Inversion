    print(f"                  {step1} - 23 = {step2}")

    # Rückschritt 3: Rückschub des Gleitfensters (-22 + 15)
    step3 = step2 - 22 + 15
    print(f"  [Rückschritt 3] Rückschub des Gleitfensters (-22 + 15):")
    print(f"                  {step2} - 22 + 15 = {step3}")
    print(f"                  --> Exakte Wiederherstellung von Zeile 3 Summe: {row_sums[2]}")

    # 4. Gitter-Lokalisierung der Basispunkte
    recovered_row = grid[2]
    print("\n4. REKONSTRUIERTE BASISPUNKTE (ZEILE 3):")
    print(f"  Punkte-Menge: {list(recovered_row)}")
    print(f"  Zentrum der Zeile (Mittelpunkt): {recovered_row[3]} (Spalte 4)")
    print(f"  Prüfung Summe == {step3}: {int(np.sum(recovered_row)) == step3}")

