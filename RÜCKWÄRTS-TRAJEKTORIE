    print("\n3. RÜCKWÄRTS-SCHRITTE (DETERMINISTISCHE UNROLLUNG):")
    
    # Rückschritt 1: Re-Attribution der Gegenkante (14er-Shift)
    step1 = attractor + 14
    print(f"  [Rückschritt 1] Re-Attribution der 14er-Gegenkante:")
