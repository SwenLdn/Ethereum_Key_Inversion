# 2. Inversions-Algebra für bloomMix (SplitMix64) in O(1)
MASK64 = 0xFFFFFFFFFFFFFFFF
M1 = 0xBF58476D1CE4E5B9
M2 = 0x94D049BB133111EB

# Modulare Inverse in Z / 2^64 Z
M1_INV = 0x96DE1B173F119089
M2_INV = 0x319642B2D24D8EC3

def unshift_right(x: int, shift: int) -> int:
    """Umkehrung der Bitwise Right-Shift XOR Transformation: y = x ^ (x >> shift)"""
    res = x
    curr = shift
    while curr < 64:
        res ^= (x >> curr)
        curr += shift
    return res & MASK64

def bloom_mix(x: int) -> int:
    """Original Go bloomMix implementation"""
    x = (x ^ (x >> 30)) & MASK64
    x = (x * M1) & MASK64
    x = (x ^ (x >> 27)) & MASK64
    x = (x * M2) & MASK64
    x = (x ^ (x >> 31)) & MASK64
    return x

def bloom_unmix(y: int) -> int:
    """Inversion of bloomMix in O(1) using modular arithmetic & bitwise unshifting"""
    y1 = unshift_right(y, 31)
    y2 = (y1 * M2_INV) & MASK64
    y3 = unshift_right(y2, 27)
    y4 = (y3 * M1_INV) & MASK64
    x = unshift_right(y4, 30)
    return x

def bloom_storage_seed_unrotate(seed_xor_salt: int) -> int:
    """Inversion der 17-Bit Rotation: (x<<17 | x>>47)"""
    y = seed_xor_salt
    return ((y >> 17) | ((y << 47) & MASK64)) & MASK64

