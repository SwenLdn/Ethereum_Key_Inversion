    pub_point = scalar_mult(priv_int, G_POINT)
    print(f"\n2. Uncompressed Public Key (64 Bytes):")
    print(f"   X: 0x{pub_point[0]:064x}")
    print(f"   Y: 0x{pub_point[1]:064x} (Paritaet Y % 2 = {pub_point[1] % 2})")

    # 3. Public Address ableiten
    addr_bytes = get_eth_address(pub_point)
    addr_hex = addr_bytes.hex()
    print(f"\n3. Erzeugte Public Address (20 Bytes):\n   0x{addr_hex}")

    # 4. Orthogonale Aufteilung der Public Address in 5 Blöcke à 32 Bit (160 / 5 = 32)
    print(f"\n4. Orthogonale Aufteilung der Public Address in 5 Bloecke a 32 Bit:")
    blocks_32 = [int.from_bytes(addr_bytes[i*4:(i+1)*4], 'big') for i in range(5)]
    for i, b in enumerate(blocks_32):
        s3_r = b >> 3
        s4_l = (b << 4) & 0xFFFFFFFF
        norm = (pow(s3_r, 2) + pow(s4_l, 2)) % 0xFFFFFFFF
        print(f"   Block {i+1}: 0x{b:08x} | Shift_3_R: 0x{s3_r:08x} | Shift_4_L: 0x{s4_l:08x} | Norm: 0x{norm:08x}")

    # 5. Spektrale Faltung & Diskrete Fourier-Transformation (DFT / iDFT)
    source_signal = np.array(list(priv_bytes), dtype=float)
    N = len(source_signal)  # 32 Bytes
    
    # Vorwärts-DFT
    fft_coeffs = np.fft.fft(source_signal)
    
    # Inverse Fourier-Transformation
    reconstructed_signal = np.fft.ifft(fft_coeffs).real
    reconstructed_bytes = bytes([int(round(x)) for x in reconstructed_signal])
    reconstructed_hex = reconstructed_bytes.hex()

    print(f"\n5. Rekonstruktions-Vergleich (Original vs. Inverse Phasen-Faltung):")
    print(f"   Original Private Key:       {priv_hex}")
    print(f"   Rekonstruierter Private Key: {reconstructed_hex}")
    is_match = (priv_hex == reconstructed_hex)
    print(f"   -> Exakte Uebereinstimmung: {is_match} (Verlust = 0.0 Bits)")

    print("\n" + "=" * 80)
    print("ERGEBNIS: Phase-Lock und Fourier-Inversion erfolgreich verifiziert.")
    print("=" * 80)

if __name__ == "__main__":
