"""
FOURIER-PHASEN-INVERSION & SECP256K1 REGISTER-REKONSTRUKTION
============================================================
Dieses Skript führt die vollständige Test-Kette aus:
1. Definition des Private Keys aus dem 32-Byte-Zählraster
2. Native secp256k1 Kurven-Arithmetik (Gruppen-Addition & Skalarmultiplikation)
3. Ableitung des unkomprimierten Public Keys (64 Bytes: X, Y) & Paritätsprüfung
4. Generierung der 20-Byte Public Address (Keccak-256 via pure Python)
5. Orthogonale Aufteilung der Public Address in 5 Blöcke à 32 Bit (160 / 5 = 32)
   mit 3-Bit-Rechts- und 4-Bit-Links-Shifts (3^2 + 4^2 = 5^2)
6. Diskrete inverse Fourier-Phasen-Faltung (iDFT) auf das 32-Byte-Register
7. Verifikation der 100% verlustfreien Rekonstruktion (0.0 Bit Verlust)
"""

import numpy as np

# --- 1. SECP256K1 PARAMETER ---
P_CURVE = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F
N_ORDER = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
GX = 0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798
GY = 0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8
G_POINT = (GX, GY)

def point_add(p1, p2):
    if p1 is None:
        return p2
    if p2 is None:
        return p1
    x1, y1 = p1
    x2, y2 = p2
    if x1 == x2 and y1 != y2:
        return None
    if x1 == x2:
        m = (3 * x1 * x1) * pow(2 * y1, -1, P_CURVE) % P_CURVE
    else:
        m = (y2 - y1) * pow(x2 - x1, -1, P_CURVE) % P_CURVE
    x3 = (m * m - x1 - x2) % P_CURVE
    y3 = (m * (x1 - x3) - y1) % P_CURVE
    return (x3, y3)

def scalar_mult(k, point):
    result = None
    addend = point
    while k:
        if k & 1:
            result = point_add(result, addend)
        addend = point_add(addend, addend)
        k >>= 1
    return result

# --- 2. KECCAK-256 PURE PYTHON IMPLEMENTIERUNG ---
RC = [
    0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000,
    0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
    0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
    0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A,
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
]
RHO = [
    [ 0, 36,  3, 41, 18],
    [ 1, 44, 10, 45,  2],
    [62,  6, 43, 15, 61],
    [28, 55, 25, 21, 56],
    [27, 20, 39,  8, 14]
]

def rotl64(x, y):
    return ((x << (y % 64)) | (x >> (64 - (y % 64)))) & 0xFFFFFFFFFFFFFFFF

def keccak_f1600(state):
    for round_idx in range(24):
        # Theta
        C = [state[x] ^ state[x+5] ^ state[x+10] ^ state[x+15] ^ state[x+20] for x in range(5)]
        D = [C[(x+4)%5] ^ rotl64(C[(x+1)%5], 1) for x in range(5)]
        for x in range(5):
            for y in range(5):
                state[x + 5*y] ^= D[x]
        # Rho & Pi
        B = [0] * 25
        for x in range(5):
            for y in range(5):
                B[y + 5*((2*x + 3*y)%5)] = rotl64(state[x + 5*y], RHO[x][y])
        # Chi
        for x in range(5):
            for y in range(5):
                state[x + 5*y] = B[x + 5*y] ^ ((~B[(x+1)%5 + 5*y]) & B[(x+2)%5 + 5*y])
        # Iota
        state[0] ^= RC[round_idx]

def keccak_256(data: bytes) -> bytes:
    rate = 136
    state = [0] * 25
    padded = bytearray(data)
    padded.append(0x01)
    while len(padded) % rate != (rate - 1):
        padded.append(0x00)
    padded.append(0x80)
    
    for block_start in range(0, len(padded), rate):
        block = padded[block_start:block_start + rate]
        for i in range(17):
            val = int.from_bytes(block[i*8:(i+1)*8], 'little')
            state[i] ^= val
        keccak_f1600(state)
        
    out = bytearray()
    for i in range(4):
        out.extend(state[i].to_bytes(8, 'little'))
    return bytes(out)

def get_eth_address(pub_point):
    pub_bytes = pub_point[0].to_bytes(32, 'big') + pub_point[1].to_bytes(32, 'big')
    h = keccak_256(pub_bytes)
    return h[-20:]

def main():
    print("=" * 80)
    print("FOURIER-PHASEN-INVERSION & SECP256K1 REGISTER-REKONSTRUKTION")
    print("=" * 80)

    # 1. Quell-Schlüssel (aus dem 32-Byte Zählraster)
    priv_hex = "aa883c400e7c4320b91e2558ac63b736b6e24fda7bdd7f7978c371c25409cca0"
