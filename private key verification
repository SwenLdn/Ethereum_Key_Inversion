print(f"Originaler Key:    0x{test_results['Original_PKey']}")
print(f"Rekonstruiert:     0x{test_results['Reconstructed_PKey']}")
print(f"Übereinstimmung:  {test_results['Match_Success']} (100% verlustfrei) 💎")
print(f"Erzeugte Adresse:  {test_results['Eth_Address']}\n")

