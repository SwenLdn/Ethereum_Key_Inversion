def modinv(a, m=P):
    """Computes modular inverse using the Extended Euclidean Algorithm."""
    return pow(a, -1, m)

def point_add(p1, p2):
    """Adds two distinct points on the secp256k1 curve."""
    if p1 is None: return p2
    if p2 is None: return p1
    x1, y1 = p1
    x2, y2 = p2
    if x1 == x2 and y1 != y2: return None
    if x1 == x2:
        m = (3 * x1 * x1) * modinv(2 * y1, P) % P
    else:
        m = (y1 - y2) * modinv(x1 - x2, P) % P
    x3 = (m * m - x1 - x2) % P
    y3 = (m * (x1 - x3) - y1) % P
    return (x3, y3)

def point_mul(scalar, p=G):
    """Performs geometric scalar multiplication via bit-shifted tracking."""
    result = None
    addend = p
    s = scalar % N
    while s:
        if s & 1:
            result = point_add(result, addend)
        addend = point_add(addend, addend)
        s >>= 1
    return result

