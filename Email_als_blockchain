import hashlib
import pandas as pd


# 1. Mathematische Simulation der Hashes und Siegel
def sha256_hex(data: str) -> str:
    return hashlib.sha256(data.encode("utf-8")).hexdigest()[:16]


M_0 = "Payload: Transfer 100 Units / Email Text"
h_M0 = sha256_hex(M_0)

# Hop 1 (Genesis)
i_1 = 1
cv_1 = "none"
aar_1 = "spf=pass; dkim=pass"
ams_1 = sha256_hex(f"AMS_sign(key=mail.example.org, hash={h_M0})")
as_1 = sha256_hex(
    f"AS_sign(key=mail.example.org, i={i_1}, cv={cv_1}, prev=EMPTY, ams={ams_1})"
)

# Hop 2 (Forwarder)
M_1 = M_0 + " [Mailinglist Footer]"
h_M1 = sha256_hex(M_1)
i_2 = 2
cv_2 = "pass"
