as_2 = sha256_hex(
    f"AS_sign(key=list.relay.org, i={i_2}, cv={cv_2}, prev={as_1}, ams={ams_2})"
)

# Hop 3 (Inbox)
i_3 = 3
cv_3 = "pass"
aar_3 = "arc=pass; dkim=pass"
ams_3 = sha256_hex(f"AMS_sign(key=inbox.final.com, hash={h_M1})")
as_3 = sha256_hex(
    f"AS_sign(key=inbox.final.com, i={i_3}, cv={cv_3}, prev={as_2}, ams={ams_3})"
)

