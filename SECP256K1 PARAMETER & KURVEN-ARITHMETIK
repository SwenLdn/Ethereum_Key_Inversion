def inv_mod(k, p=P_CURVE):
    if k == 0:
        raise ZeroDivisionError('Division durch Null')
    if k < 0:
        return p - inv_mod(-k, p)
    s, old_s = 0, 1
    t, old_t = 1, 0
    r, old_r = p, k
    while r != 0:
        q = old_r // r
        old_r, r = r, old_r - q * r
        old_s, s = s, old_s - q * s
        old_t, t = t, old_t - q * t
    return old_s % p

def point_add(p1, p2):
    if p1 is None:
        return p2
    if p2 is None:
        return p1
    x1, y1 = p1
    x2, y2 = p2
    if x1 == x2 and y1 != y2:
        return None
    if x1 == x2:
        m = (3 * x1 * x1 + A_CURVE) * inv_mod(2 * y1, P_CURVE) % P_CURVE
    else:
        m = (y2 - y1) * inv_mod(x2 - x1, P_CURVE) % P_CURVE
    x3 = (m * m - x1 - x2) % P_CURVE
    y3 = (m * (x1 - x3) - y1) % P_CURVE
    return (x3, y3)

def scalar_mult(k, point=(G_X, G_Y)):
    current = point
    result = None
    while k > 0:
        if k & 1:
            result = point_add(result, current)
        current = point_add(current, current)
        k >>= 1
    return result

