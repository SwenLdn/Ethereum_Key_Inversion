def keccak_f1600(state):
    lanes = [[state[x + 5 * y] for y in range(5)] for x in range(5)]
    for round_idx in range(24):
        C = [lanes[x][0] ^ lanes[x][1] ^ lanes[x][2] ^ lanes[x][3] ^ lanes[x][4] for x in range(5)]
        D = [C[(x - 1) % 5] ^ rotl64(C[(x + 1) % 5], 1) for x in range(5)]
        for x in range(5):
            for y in range(5):
                lanes[x][y] ^= D[x]
        B = [[0] * 5 for _ in range(5)]
        for x in range(5):
            for y in range(5):
                B[y][(2 * x + 3 * y) % 5] = rotl64(lanes[x][y], R[x][y])
        for x in range(5):
            for y in range(5):
                lanes[x][y] = B[x][y] ^ ((~B[(x + 1) % 5][y]) & B[(x + 2) % 5][y])
        lanes[0][0] ^= RC[round_idx]
    out = [0] * 25
    for x in range(5):
        for y in range(5):
            out[x + 5 * y] = lanes[x][y]
    return out

def keccak_256(data: bytes) -> bytes:
    rate = 136
    padded = bytearray(data)
    padded.append(0x01)
    while len(padded) % rate != (rate - 1):
        padded.append(0x00)
    padded.append(0x80)
    state = [0] * 25
    for block_start in range(0, len(padded), rate):
        block = padded[block_start:block_start + rate]
        for i in range(rate // 8):
            lane_bytes = block[i * 8:(i + 1) * 8]
            lane_val = int.from_bytes(lane_bytes, byteorder='little')
            state[i] ^= lane_val
        state = keccak_f1600(state)
    out_bytes = bytearray()
    for i in range(4):
        out_bytes.extend(state[i].to_bytes(8, byteorder='little'))
    return bytes(out_bytes[:32])

