            try:
                res = future.result()
                results.append(res)
            except Exception as exc:
                print(f" Fehler bei der Verarbeitung: {exc}")

    exec_time = (time.time() - start_time) * 1000

    # Sort results by ID for consistent reporting
    results.sort(key=lambda x: x["id"])

    # Summary Statistics
    quadrant_counts = {"Q1": 0, "Q2": 0, "Q3": 0, "Q4": 0}
    zero_gate_locks = 0
    popcounts = []

    print("-" * 85)
