def analyze_transaction_entry(tx):
    """
    Worker function executed in parallel across multiple threads.
    Analyzes the LSB 64-bit register slice (Slice 0) and structural invariants.
    """
    d_val = tx["d"]
    z_val = tx["z"]
    r_val = tx["r"]
    s_val = tx["s"]

    # 1. 64-Bit Register Slices
    slice_0 = (d_val >> 0) & 0xFFFFFFFFFFFFFFFF   # LSB Word 0
    slice_1 = (d_val >> 64) & 0xFFFFFFFFFFFFFFFF  # Word 1
    slice_2 = (d_val >> 128) & 0xFFFFFFFFFFFFFFFF # Word 2
    slice_3 = (d_val >> 192) & 0xFFFFFFFFFFFFFFFF # MSB Word 3

    # 2. LSB Slice 0 Frequency & Residue Properties
    slice_0_mod11 = slice_0 % 11
    slice_0_mod121 = slice_0 % 121
    slice_0_mod12 = slice_0 % 12
    slice_0_mod64 = slice_0 % 64
    slice_0_popcount = bin(slice_0).count('1') # Hamming weight (Bit density)
    
    # 3. Quadrant & Metro/Pompeii Mapping
    quadrant = (d_val * 4) // N + 1
    insula_id = (d_val >> 192) % 64
    metro_station_id = (insula_id * 7 + 14) % 12

    # 4. Midpoint Delta Offset & Symmetry Gate
    delta_mid = (d_val - K_MID) % N
    fermat_zero_gate_lock = (slice_0_mod11 == 0) or (slice_0_mod121 == 0)

    # Return structured audit record
    return {
        "id": tx["id"],
        "sender": tx["sender"],
        "d_hex": hex(d_val),
        "slice_0_hex": f"0x{slice_0:016x}",
        "slice_0_dec": slice_0,
        "slice_0_popcount": slice_0_popcount,
        "slice_0_mod11": slice_0_mod11,
        "slice_0_mod121": slice_0_mod121,
        "slice_0_mod12": slice_0_mod12,
        "slice_0_mod64": slice_0_mod64,
        "quadrant": f"Q{quadrant}",
        "insula_id": insula_id,
        "metro_station_id": metro_station_id,
        "fermat_zero_gate_lock": fermat_zero_gate_lock,
        "delta_mid_hex": hex(delta_mid)
    }

def run_multithreaded_audit():
    print("=" * 85)
