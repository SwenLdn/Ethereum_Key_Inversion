    print(f" Modulo-Resonanzen  : Z_11, Z_121 (Fermat Zero Gate 22), Z_12 (Metro Ring), Z_64 (Pompeii)")
    print(f" Thread Pool-Größe : 4 parallele Ausführungsthreads\n")

    start_time = time.time()

    # Multithreaded execution using ThreadPoolExecutor
    results = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:
        future_to_tx = {executor.submit(analyze_transaction_entry, tx): tx for tx in AUDIT_TRANSACTIONS}
