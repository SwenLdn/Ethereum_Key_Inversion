    print("-" * 85)

    for r in results:
        quadrant_counts[r["quadrant"]] += 1
        if r["fermat_zero_gate_lock"]:
            zero_gate_locks += 1
        popcounts.append(r["slice_0_popcount"])

        lock_str = " [ZERO LOCK]" if r["fermat_zero_gate_lock"] else "  Pass"
        print(f"{r['id']:<28} | {r['slice_0_hex']:<18} | {r['slice_0_popcount']:<6d} | {r['slice_0_mod11']:<5d} | {r['slice_0_mod12']:<5d} | {r['quadrant']:<4} |{lock_str}")

    print("-" * 85)
    print("\n=== AGGREGIERTE REFREQUENZ- & DENSITY-STATISTIK ===")
    print(f" Verarbeitungszeit (Parallel): {exec_time:.2f} ms")
    print(f" Quadranten-Verteilung      : {quadrant_counts}")
    print(f" Zero-Gate Locks (Mod11==0) : {zero_gate_locks} / {len(results)} Transaktionen")
    print(f" Durchschnitts-Hamming-Gewicht (Slice 0): {np.mean(popcounts):.2f} / 64 Bit")
    print(f" Min/Max Hamming-Gewicht     : Min={np.min(popcounts)} Bit | Max={np.max(popcounts)} Bit")
    print("=" * 85)

